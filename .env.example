# =============================================================================
# Mirror — Environment Variables (Example)
#
# このファイルは Phase 0 で全 Phase 分の変数を網羅的に定義したテンプレートです。
# 各変数は対応する Phase で初めて使用されます。Phase 0 の起動だけならコピーして
# .env.local を作るだけで OK（多くの変数は空でも開発サーバは起動可能）。
#
# 本番（Vercel）では Vercel Dashboard で環境変数を設定してください。
# .env* ファイルはコミットしないこと（.gitignore で除外済み）。
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1: Auth (NextAuth.js / Auth.js v5)
# -----------------------------------------------------------------------------
# Auth.js v5 は AUTH_SECRET / AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET を使用。
# AUTH_SECRET は `pnpm dlx auth secret` で生成可能。
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js v5 が trust する URL。Vercel では自動付与されるが、ローカルでは設定する。
AUTH_URL=http://localhost:3000

# Phase 2 で Drive API スコープを追加するため、OAuth 同意画面側でスコープを許可：
#   - openid email profile
#   - https://www.googleapis.com/auth/drive.file (Phase 2 以降)

# -----------------------------------------------------------------------------
# Phase 1: Database (Vercel Postgres)
# -----------------------------------------------------------------------------
# Vercel Postgres を Vercel Dashboard 上で作成すると、自動で以下の変数が
# プロジェクトに注入される。ローカルでは `vercel env pull .env.local` を使う。
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_HOST=

# -----------------------------------------------------------------------------
# Phase 4: APIキー暗号化（クローン主のパスワード由来鍵）
# -----------------------------------------------------------------------------
# 暗号化方式は AES-256-GCM、鍵導出は PBKDF2-SHA256 (100k iterations)。
# サーバ側でユーザーパスワードを保管しないため、サーバ用の固定鍵は不要。
# ただし、Drive 上の暗号化ファイルに付加する追加 salt（プロジェクト固有）が
# 必要なら以下に設定（Phase 4 で確定）。
# MIRROR_ENCRYPTION_PEPPER=

# -----------------------------------------------------------------------------
# Phase 5: Anthropic Claude API
# -----------------------------------------------------------------------------
# Mirror サーバ側では使わない（クローン主の APIキーを Drive から復号して都度使用）。
# 開発時の動作確認用に運営者の APIキーをローカルでのみ設定可能。
# 本番では絶対にサーバに保存しないこと。
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Phase 7: 招待コード（ハッシュ化用 pepper）
# -----------------------------------------------------------------------------
# DB に保存する招待コードハッシュへの追加 pepper。Phase 7 開始時に確定。
# INVITE_CODE_PEPPER=

# -----------------------------------------------------------------------------
# Phase 11: Stripe (決済・サブスクリプション)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_OWNER_MONTHLY=

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# クライアントから参照する公開 URL（NEXT_PUBLIC_* はビルド時にバンドルされる）。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 実行環境タグ（"development" | "preview" | "production"）。Vercel が自動設定。
# NEXT_PUBLIC_VERCEL_ENV=
